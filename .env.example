# =============================================================================
# AskData Quality Suite — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- AskData Target ---
ASKDATA_BASE_URL=https://ask-data-gilt.vercel.app
# If the app exposes an API route (e.g., /api/query), set it here:
ASKDATA_API_URL=https://ask-data-gilt.vercel.app/api

# --- Groq (Free LLM Judge for DeepEval) ---
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- E2E Browser Tests ---
# If AskData requires authentication:
ASKDATA_USERNAME=
ASKDATA_PASSWORD=
# Browser: chromium, firefox, webkit
PLAYWRIGHT_BROWSER=chromium
# Set to "true" to see the browser during local test runs
PLAYWRIGHT_HEADED=false

# --- Test Configuration ---
# Maximum seconds per test before timeout
TEST_TIMEOUT=120
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- CI/CD ---
# Set to "true" in GitHub Actions
CI=false
