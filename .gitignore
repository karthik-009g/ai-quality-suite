htmlcov/
.coverage
coverage.xml
test-results/
playwright-report/
state.json
*.trace.zip

# --- Playwright ---
test-results/
playwright-report/
state.json
*.trace.zip

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Misc ---
