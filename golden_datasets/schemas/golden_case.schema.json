{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Golden Dataset Case",
  "description": "Schema for NL-to-SQL golden test case files used in the AskData Quality Suite",
  "type": "object",
  "required": ["version", "tier", "description", "cases"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the dataset"
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Difficulty tier (1=simple, 5=ambiguous)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this tier"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "category", "difficulty", "natural_language",
          "expected_sql", "expected_columns", "expected_row_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GD-\\d{3}$",
            "description": "Unique case identifier (e.g., GD-001)"
          },
          "category": {
            "type": "string",
            "description": "Category of the query type"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "natural_language": {
            "type": "string",
            "minLength": 5,
            "description": "The natural language question a user would ask"
          },
          "expected_sql": {
            "type": "string",
            "minLength": 10,
            "description": "The expected SQL query"
          },
          "expected_columns": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "description": "Expected column names in the result"
          },
          "expected_row_count": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": {"type": "integer", "minimum": 0},
              "max": {"type": "integer", "minimum": 0}
            }
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Searchable tags for filtering"
          },
          "edge_case": {
            "type": "boolean",
            "default": false
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the test case"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        }
      }
    }
  }
}
